// Wi-Fi
#define SUNISLE_WIFI_SSID      "YOUR_WIFI_SSID"
#define SUNISLE_WIFI_PASSWORD  "YOUR_WIFI_PASSWORD"

// 天气显示用的城市
#define SUNISLE_CITY_NAME      "Shanghai"
#define SUNISLE_CITY_LAT       "31.2304"
#define SUNISLE_CITY_LON       "121.4737"

// 时区（乐鑫 NTP 格式，CST-8 = 东八区）
#define SUNISLE_TZ_STRING      "CST-8"

// 照片/数据同步服务器
// 办公室默认指向内网 NAS(10.10.100.10)；在家时请改成你能访问的地址
#define SUNISLE_SYNC_HOST      "10.10.100.10"
#define SUNISLE_SYNC_PORT      "80"

// 设备令牌（若服务端需要鉴权）
#define SUNISLE_DEVICE_TOKEN   "YOUR_DEVICE_TOKEN"
