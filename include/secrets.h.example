#pragma once
// ============================================================
//  SUNISLE 本地密钥模板
//  复制本文件为 secrets.h 并填入你自己的值：
//      cp include/secrets.h.example include/secrets.h
//  secrets.h 已被 .gitignore 忽略，不会上传到 GitHub。
// ============================================================

// Wi-Fi（可配置多个，设备会依次尝试直到连上其中一个）
#define SUNISLE_WIFI_SSID      "YOUR_WIFI_SSID"
#define SUNISLE_WIFI_PASSWORD  "YOUR_WIFI_PASSWORD"

// 备用网络（例如家里）：设备会依次尝试主网络与此网络
#define SUNISLE_WIFI_SSID_2    "YOUR_WIFI_SSID_2"
#define SUNISLE_WIFI_PASSWORD_2 "YOUR_WIFI_PASSWORD_2"

// 天气显示用的城市
#define SUNISLE_CITY_NAME      "Shanghai"
#define SUNISLE_CITY_LAT       "31.2304"
#define SUNISLE_CITY_LON       "121.4737"

// 时区（乐鑫 NTP 格式，CST-8 = 东八区）
#define SUNISLE_TZ_STRING      "CST-8"

// 照片/数据同步服务器
// 办公室默认指向内网 NAS(10.10.100.10)；在家时请改成你能访问的地址
#define SUNISLE_SYNC_HOST      "10.10.100.10"
#define SUNISLE_SYNC_PORT      "80"

// 设备令牌（若服务端需要鉴权）
#define SUNISLE_DEVICE_TOKEN   "YOUR_DEVICE_TOKEN"

// ---- B 版：WorkBuddy 网络下发指令（可选）----
// 留空 SUNISLE_CMD_HOST 即关闭网络通道，只用串口下达指令。
// 协议：设备在每个 WiFi 窗口 GET <path>?device=sunisle-b&proto=1，
// 响应体每行一条指令（CMD| / SKILL| / TASK|），逐行执行并回 ACK/ERR。
#define SUNISLE_CMD_HOST   ""
#define SUNISLE_CMD_PORT   "80"
#define SUNISLE_CMD_PATH   "/api/commands"
#define SUNISLE_CMD_TOKEN  "YOUR_OPTIONAL_TOKEN"
